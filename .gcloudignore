# This file defines which files are NOT uploaded to Cloud Build for remote building

.gcloudignore
.git
.gitignore

# node_modules
node_modules/
backend/node_modules/
frontend/node_modules/

# local builds
frontend/dist/

# local database backups and data
*.db
*.db.zip
*.sqlite3

# environment variables
.env
.env.local
.env.production
.env.development
backend/.env
frontend/.env
.env.secrets

# macOS files
.DS_Store

# docker logs
*.log
